# ---------------------------------------------------------------------------
# NeuroMesh Protocol - ignore rules
# ---------------------------------------------------------------------------

# Dependencies
node_modules/
.pnp.*

# Secrets - NEVER COMMIT
# `.env.*` covers .env.local / .env.production; the negation keeps the template.
.env
.env.*
!.env.example
*.pem
*.key
keystore/

# Hardhat / Solidity build output
artifacts/
cache/
typechain-types/

# Tests & coverage
coverage/
coverage.json
.nyc_output/
lcov.info

# Generated reports & simulation output
# NOTE: simulation-results.json is generated by `npm run simulate` and is NOT
# tracked. Every consumer (dashboard, README benchmarks, docs) must degrade
# gracefully when it is absent on a fresh clone - treat missing as "no data yet",
# never as an error.
reports/
simulation-results.json
*.docx.tmp

# Build output
dist/
build/

# Model / runtime caches
.cache/
.transformers-cache/

# Logs
*.log
logs/
npm-debug.log*
yarn-error.log*

# Editors / OS
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.DS_Store
Thumbs.db
*.swp

# Tooling internals
.husky/_/
.eslintcache
.gemini/

# Local scratch files (never committed)
scratch_test.js
.smoke-tmp.mjs
.bench-tmp.mjs
.conncheck.mjs

# Local workflow scripts (never committed)
.wf/

# Local chain deployment records (ephemeral)
deployments/31337.json
deployments/1337.json
reports/
