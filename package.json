{
  "name": "neuromesh-protocol",
  "version": "2.1.0",
  "description": "Decentralized cognitive memory protocol for autonomous AI agents: on-chain identity and reputation, IPFS-anchored encrypted memories, and cross-model semantic synchronization.",
  "keywords": [
    "blockchain",
    "ethereum",
    "solidity",
    "ai-agents",
    "agent-memory",
    "ipfs",
    "semantic-search",
    "embeddings",
    "decentralized-ai",
    "web3",
    "sepolia",
    "aes-256-gcm"
  ],
  "homepage": "https://github.com/v3nom-95/NeuroMesh#readme",
  "bugs": {
    "url": "https://github.com/v3nom-95/NeuroMesh/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/v3nom-95/NeuroMesh.git"
  },
  "license": "Apache-2.0",
  "author": "NeuroMesh Protocol contributors",
  "type": "module",
  "main": "./server.js",
  "files": [
    "src/",
    "lib/",
    "contracts/",
    "public/",
    "scripts/",
    "server.js",
    "README.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:sol": "solhint \"contracts/**/*.sol\"",
    "lint:all": "npm run lint && npm run lint:sol",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "compile": "hardhat compile",
    "clean": "hardhat clean && node -e \"for (const d of ['coverage','.nyc_output','reports','dist']) require('fs').rmSync(d, { recursive: true, force: true })\"",
    "test": "npm run test:unit && npm run test:contracts",
    "test:unit": "node --test --test-reporter=spec test/backend",
    "test:watch": "node --test --watch test/backend",
    "test:contracts": "hardhat test",
    "test:coverage": "node --test --experimental-test-coverage --test-reporter=spec test/backend",
    "coverage:sol": "hardhat coverage",
    "deploy:sepolia": "hardhat run scripts/deploy.js --network sepolia",
    "deploy:local": "hardhat run scripts/deploy.js --network localhost",
    "verify": "hardhat run scripts/verify.js --network sepolia",
    "node:local": "hardhat node",
    "simulate": "node scripts/simulate.js",
    "benchmark": "node scripts/simulate.js",
    "report": "node scripts/generate-report.js",
    "audit": "npm audit --audit-level=high --omit=dev",
    "docker:build": "docker build -t neuromesh-protocol:local .",
    "docker:run": "docker run --rm --env-file .env -p 7860:7860 neuromesh-protocol:local",
    "ci": "npm run lint:all && npm run format:check && npm run typecheck && npm run compile && npm run test"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "axios": "^1.20.0",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "docx": "^9.7.2",
    "dotenv": "^17.4.2",
    "ethers": "^6.17.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "form-data": "^4.0.6",
    "helmet": "^8.3.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@openzeppelin/contracts": "^5.6.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "hardhat": "^2.29.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6",
    "solhint": "^6.2.4",
    "supertest": "^7.2.2",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "sharp": "^0.35.4",
    "adm-zip": "^0.6.0"
  }
}
